        <mxCell id="act0" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#ffffff;" vertex="1" parent="web">
          <mxGeometry x="45" y="90" width="10" height="850" as="geometry"/>
