          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="追加缓冲并播放" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6;entryX=1;entryY=0.6353;" edge="1" parent="1" source="act0" target="act0">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="150" y="640"/><mxPoint x="150" y="670"/></Array>
