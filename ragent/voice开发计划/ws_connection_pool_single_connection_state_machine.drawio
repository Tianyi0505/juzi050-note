<mxfile host="app.diagrams.net" modified="2026-08-06T19:38:00.000Z" agent="ChatGPT" version="24.7.17">
  <diagram id="ws-connection-state-machine" name="WS连接池-单连接状态机">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="WS 连接池中一条物理连接的完整状态机" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="770" y="80" width="24" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="new" value="NEW&#xa;尚未建立 WebSocket" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="130" width="300" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="connecting" value="CONNECTING&#xa;正在创建并等待连接就绪" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="250" width="300" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="idle" value="IDLE&#xa;无任务，可被连接池借出&#xa;currentTaskId == null" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="390" width="300" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="taskStarting" value="TASK_STARTING&#xa;已占用连接，正在发送 run-task&#xa;并等待 task-started" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="540" width="300" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="taskRunning" value="TASK_RUNNING&#xa;当前 taskId 独占连接&#xa;可持续发送任务内容" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="690" width="300" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="taskFinishing" value="TASK_FINISHING&#xa;已发送 finish/cancel&#xa;等待任务终态" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="840" width="300" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="broken" value="BROKEN&#xa;连接已不可复用&#xa;但资源尚未统一销毁" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1080" y="520" width="300" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="closed" value="CLOSED&#xa;物理 WebSocket 已关闭&#xa;任务和连接引用已清理" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#e6e6e6;strokeColor=#666666;fontSize=16;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1080" y="850" width="300" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="poolBox" value="&lt;b&gt;连接池借还规则&lt;/b&gt;&lt;br&gt;&lt;br&gt;借出：borrowObject() 前执行 testOnBorrow&lt;br&gt;仅 IDLE 且 currentTaskId == null 可通过&lt;br&gt;&lt;br&gt;归还：lease.close()&lt;br&gt;• 仍为 IDLE → returnObject()&lt;br&gt;• 非 IDLE → invalidateObject() → destroyObject() → CLOSED" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="360" width="430" height="240" as="geometry"/>
        </mxCell>

        <mxCell id="abnormalBox" value="&lt;b&gt;异常来源&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 厂商主动 onClosed&lt;br&gt;• 网络 onFailure&lt;br&gt;• task-failed&lt;br&gt;• 协议解析异常&lt;br&gt;• 建连/启动/结束等待超时&lt;br&gt;&lt;br&gt;处理：markBroken() + callback.onError()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="250" width="340" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="closeNote" value="&lt;b&gt;主动关闭来源&lt;/b&gt;&lt;br&gt;&lt;br&gt;• WsExecutor / Spring 容器关闭&lt;br&gt;• maxIdle 超限淘汰&lt;br&gt;• invalidateObject 销毁&lt;br&gt;• 手动 close()&lt;br&gt;• 当前 TtsTask.cancel() 直接 close()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1000" width="360" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="eStart" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="start" target="new">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eNewConnecting" value="connect()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;" edge="1" parent="1" source="new" target="connecting">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eConnectingIdle" value="openWebSocket + awaitConnectionReady 成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="connecting" target="idle">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eIdleStarting" value="acquire() 后 startTask()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;" edge="1" parent="1" source="idle" target="taskStarting">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eStartingRunning" value="run-task 成功 + 收到 task-started" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="taskStarting" target="taskRunning">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eRunningFinishing" value="finishTask() / cancelTask()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=14;" edge="1" parent="1" source="taskRunning" target="taskFinishing">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eFinishingIdle" value="收到 task-finished&#xa;clearTaskContext()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="taskFinishing" target="idle">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="885"/>
              <mxPoint x="560" y="435"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="eConnectingBroken" value="建连或初始化失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontColor=#b85450;dashed=1;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="connecting" target="broken">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eStartingBroken" value="任务启动失败 / 超时" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontColor=#b85450;dashed=1;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="taskStarting" target="broken">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eRunningBroken" value="onClosed / onFailure / task-failed / 协议异常" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontColor=#b85450;dashed=1;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="taskRunning" target="broken">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eFinishingBroken" value="任务结束或取消失败 / 超时" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontColor=#b85450;dashed=1;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="taskFinishing" target="broken">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eIdleBroken" value="空闲期间被厂商断开" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontColor=#b85450;dashed=1;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="idle" target="broken">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eBrokenClosed" value="lease.close()&#xa;invalidateObject → destroyObject → close()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="broken" target="closed">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eIdleClosed" value="池关闭 / maxIdle 淘汰 / 手动 close()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="idle" target="closed">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1010" y="435"/>
              <mxPoint x="1010" y="900"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="eRunningClosed" value="当前实现：TtsTask.cancel() 直接 connection.close()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;" edge="1" parent="1" source="taskRunning" target="closed">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eAnyClose1" value="close()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1;dashed=1;fontSize=12;" edge="1" parent="1" source="connecting" target="closed">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="970" y="290"/>
              <mxPoint x="970" y="900"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="eAnyClose2" value="close()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1;dashed=1;fontSize=12;" edge="1" parent="1" source="taskStarting" target="closed">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="980" y="585"/>
              <mxPoint x="980" y="900"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="eAnyClose3" value="close()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1;dashed=1;fontSize=12;" edge="1" parent="1" source="taskFinishing" target="closed">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eClosedSelf" value="重复 close()：幂等返回" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1;dashed=1;fontSize=12;loopDirection=1;" edge="1" parent="1" source="closed" target="closed">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="ePoolIdle" value="可借出 / 可归还" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#666666;fontColor=#666666;fontSize=12;" edge="1" parent="1" source="poolBox" target="idle">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="eAbnormalBroken" value="统一进入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=12;" edge="1" parent="1" source="abnormalBox" target="broken">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

