        <mxCell id="taskExecutor" value="&lt;b&gt;WebSocketTaskExecutor&lt;/b&gt;" style="swimlane;startSize=36;horizontal=1;rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;fontColor=#1e3a5f;" vertex="1" parent="package">
          <mxGeometry x="1020" y="100" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="taskExecutorBody" value="职责：借用连接、启动任务并返回会话&#xa;- webSocketExecutor: WebSocketExecutor&#xa;&#xa;+ openTask(...)&#xa;+ close()" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#334155;" vertex="1" parent="taskExecutor">
          <mxGeometry x="0" y="36" width="360" height="134" as="geometry" />
        </mxCell>

        <mxCell id="executor" value="&lt;b&gt;WebSocketExecutor&lt;/b&gt;" style="swimlane;startSize=36;horizontal=1;rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;fontColor=#1e3a5f;" vertex="1" parent="package">
          <mxGeometry x="120" y="100" width="360" height="180" as="geometry" />
        </mxCell>
        <mxCell id="executorBody" value="职责：按 modelId 管理物理连接池&#xa;- poolsByModelId: modelId → 连接池&#xa;&#xa;+ acquire(target)&#xa;+ close()" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#334155;" vertex="1" parent="executor">
          <mxGeometry x="0" y="36" width="360" height="144" as="geometry" />
        </mxCell>

        <mxCell id="taskSession" value="&lt;b&gt;WebSocketTaskSession&lt;/b&gt;" style="swimlane;startSize=36;horizontal=1;rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;fontColor=#1e3a5f;" vertex="1" parent="package">
          <mxGeometry x="1020" y="360" width="360" height="200" as="geometry" />
        </mxCell>
        <mxCell id="taskSessionBody" value="职责：串行控制单任务并负责释放连接租约&#xa;- connection: VoiceConnection&#xa;- lease: WebSocketConnectionLease（生命周期）&#xa;&#xa;+ send(input)&#xa;+ finish()&#xa;+ cancel()" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#334155;" vertex="1" parent="taskSession">
          <mxGeometry x="0" y="36" width="360" height="164" as="geometry" />
        </mxCell>

