        <mxCell id="resourceLaneLabel" value="&lt;b&gt;连接资源线&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#475569;" vertex="1" parent="package">
          <mxGeometry x="120" y="55" width="360" height="30" as="geometry" />
        </mxCell>
        <mxCell id="taskLaneLabel" value="&lt;b&gt;任务调度线&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=15;fontColor=#475569;" vertex="1" parent="package">
          <mxGeometry x="1020" y="55" width="360" height="30" as="geometry" />
