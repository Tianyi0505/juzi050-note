          <mxGeometry x="545" y="350" width="410" height="220" as="geometry" />
        </mxCell>
        <mxCell id="connectionBody" value="职责：维护物理 WebSocket 与单任务状态机&#xa;- state / currentTaskId / currentCallback&#xa;&#xa;+ connect() / startTask() / send()&#xa;+ finishTask() / cancelTask()&#xa;+ isReusable() / close()" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#334155;" vertex="1" parent="connection">
          <mxGeometry x="0" y="36" width="410" height="184" as="geometry" />
        </mxCell>

