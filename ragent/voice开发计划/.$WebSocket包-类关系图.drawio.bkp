        <mxCell id="eTaskExecutorSession" value="«create»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#475569;strokeWidth=2;endArrow=open;endFill=0;dashed=1;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="package" source="taskExecutor" target="taskSession"><mxGeometry relative="1" as="geometry" /></mxCell>
