        <mxCell id="eSessionConnection" value="控制任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#475569;strokeWidth=2;endArrow=open;endFill=0;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="package" source="taskSession" target="connection"><mxGeometry relative="1" as="geometry" /></mxCell>
