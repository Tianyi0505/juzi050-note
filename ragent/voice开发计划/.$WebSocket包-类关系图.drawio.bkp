          <mxGeometry x="930" y="720" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="stateBody" value="CONNECTING / IDLE / TASK_STARTING / TASK_RUNNING&#xa;TASK_FINISHING / TASK_CANCELLING / BROKEN / CLOSED" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#334155;" vertex="1" parent="state">
