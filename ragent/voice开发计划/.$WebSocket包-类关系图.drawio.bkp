          <mxGeometry x="210" y="720" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="callbackBody" value="职责：过滤终态后的重复回调&#xa;+ onPacket() / onComplete() / onError()" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#334155;" vertex="1" parent="callback">
          <mxGeometry x="0" y="36" width="360" height="74" as="geometry" />
