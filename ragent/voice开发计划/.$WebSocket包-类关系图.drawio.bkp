          <mxGeometry x="120" y="370" width="360" height="180" as="geometry" />
        </mxCell>
        <mxCell id="leaseBody" value="职责：包装一次连接借用并决定归还/失效&#xa;- pool / connection&#xa;&#xa;+ connection()&#xa;+ invalidate()&#xa;+ close()" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#334155;" vertex="1" parent="lease">
          <mxGeometry x="0" y="36" width="360" height="144" as="geometry" />
        </mxCell>

