{
  "title": "TTS 正常播放时序",
  "participants": [
    {"id": "web", "label": "Web / MSE", "actor": true},
    {"id": "entry", "label": "Controller / PlaybackService"},
    {"id": "handler", "label": "VoicePlaybackEventHandler"},
    {"id": "routing", "label": "RoutingTtsService"},
    {"id": "ws", "label": "WebSocket TTS"},
    {"id": "provider", "label": "百炼 CosyVoice"}
  ],
  "messages": [
    {"from": "web", "to": "entry", "label": "GET /rag/v3/voice/play?messageId"},
    {"from": "entry", "to": "entry", "label": "查询 assistant 消息；生成业务 taskId"},
    {"from": "entry", "to": "handler", "label": "创建 SSE Handler"},
    {"from": "handler", "to": "handler", "label": "注册任务；绑定 SSE 生命周期"},
    {"from": "handler", "to": "web", "label": "SSE audio-meta(taskId)", "async": true, "activate": false},
    {"from": "entry", "to": "routing", "label": "异步 synthesize(text, callback)", "async": true},
    {"from": "routing", "to": "ws", "label": "synthesize(text, selectedTarget)"},
    {"from": "ws", "to": "provider", "label": "run-task；continue-task × N；finish-task"},
    {"from": "provider", "to": "ws", "label": "task-started", "async": true, "activate": false},
    {"from": "provider", "to": "ws", "label": "MP3 frame", "async": true, "activate": false},
    {"from": "ws", "to": "routing", "label": "onAudio(audio)", "async": true, "activate": false},
    {"from": "routing", "to": "handler", "label": "callback.onAudio(audio)", "async": true, "activate": false},
    {"from": "handler", "to": "web", "label": "SSE audio(base64)", "async": true, "activate": false},
    {"from": "web", "to": "web", "label": "appendBuffer；首帧入缓冲后播放"},
    {"from": "provider", "to": "ws", "label": "task-finished", "async": true, "activate": false},
    {"from": "ws", "to": "routing", "label": "onComplete()", "async": true, "activate": false},
    {"from": "routing", "to": "handler", "label": "callback.onComplete()", "async": true, "activate": false},
    {"from": "handler", "to": "web", "label": "SSE done；完成 SSE", "async": true, "activate": false},
    {"from": "web", "to": "web", "label": "排空缓冲；MediaSource.endOfStream()"},
    {"from": "ws", "to": "ws", "label": "VoiceConnection → IDLE"},
    {"from": "ws", "to": "ws", "label": "lease.close() → 归还连接池"}
  ]
}
